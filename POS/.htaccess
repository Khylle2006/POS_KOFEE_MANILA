# Disable directory indexing
Options -Indexes

# Block version-control and dependency metadata from the web.
RedirectMatch 404 (?i)/\.git
RedirectMatch 404 (?i)/node_modules
RedirectMatch 404 (?i)/(package|package-lock)\.json$
RedirectMatch 404 (?i)/vite\.config\.js$
RedirectMatch 404 (?i)/(composer\.json|phpunit\.xml|phpcs\.xml|phpstan\.neon)$

<FilesMatch "(?i)\.(sql|md|log|lock|example)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(self)"
  Header always unset X-Powered-By
</IfModule>

# ── Static Asset Browser Caching (Speed & Performance) ───────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"

  # Images & Media
  ExpiresByType image/jpg                 "access plus 7 days"
  ExpiresByType image/jpeg                "access plus 7 days"
  ExpiresByType image/gif                 "access plus 7 days"
  ExpiresByType image/png                 "access plus 7 days"
  ExpiresByType image/webp                "access plus 7 days"
  ExpiresByType image/svg+xml             "access plus 7 days"
  ExpiresByType image/x-icon              "access plus 30 days"

  # Fonts
  ExpiresByType font/woff2                "access plus 30 days"
  ExpiresByType font/woff                 "access plus 30 days"
  ExpiresByType font/ttf                  "access plus 30 days"

  # Stylesheets & Scripts
  ExpiresByType text/css                  "access plus 1 day"
  ExpiresByType application/javascript    "access plus 1 day"
  ExpiresByType text/javascript           "access plus 1 day"
</IfModule>

# Dynamic files (PHP) default to no-cache unless specifically managed
<FilesMatch "(?i)\.(php)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "private, no-cache, no-store, must-revalidate"
  </IfModule>
</FilesMatch>
# Backups and development tools are never deployment endpoints.
RedirectMatch 404 (?i)/(scratch|tests|tools|vendor|database|dist|\.test-mysql|\.phpunit\.cache|\.phpstan\.cache)(/|$)
<FilesMatch "(?i)\.(zip|gz|tar|7z|phar|env|ini|bak|backup)$">
  Require all denied
</FilesMatch>

RedirectMatch 404 (?i)/\.test-[^/]*(/|$)

<Files "hash.php">
  Require all denied
</Files>
