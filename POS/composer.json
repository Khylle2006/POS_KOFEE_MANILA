{
  "name": "kofee-manila/pos",
  "description": "Backend verification tools for the existing PHP application",
  "type": "project",
  "require": { "php": ">=8.2", "ext-pdo": "*", "ext-pdo_mysql": "*", "ext-curl": "*", "ext-fileinfo": "*", "ext-openssl": "*", "ext-mbstring": "*" },
  "require-dev": { "phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1", "squizlabs/php_codesniffer": "^3.13" },
  "config": { "allow-plugins": false, "sort-packages": true },
  "scripts": {
    "test": "phpunit",
    "typecheck": "phpstan analyse --no-progress",
    "lint": "phpcs"
  }
}
