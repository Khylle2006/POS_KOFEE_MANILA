# ─────────────────────────────────────────────────────────────
#  POS_KOFEE_MANILA - Root Web Server Configuration
# ─────────────────────────────────────────────────────────────

# 1. DISABLE DIRECTORY BROWSING / INDEXING
# Prevents Apache from listing files and folders when no index exists (403 Forbidden).
Options -Indexes

# 2. BLOCK DIRECT ACCESS TO SYSTEM, DEPENDENCIES & METADATA
RedirectMatch 404 (?i)/\.git
RedirectMatch 404 (?i)/node_modules
RedirectMatch 404 (?i)/(package|package-lock)\.json$
RedirectMatch 404 (?i)/vite\.config\.js$
RedirectMatch 404 (?i)/(composer\.json|phpunit\.xml|phpcs\.xml|phpstan\.neon)$

# 3. BLOCK ACCESS TO SENSITIVE EXTENSIONS
<FilesMatch "(?i)\.(sql|env|log|md|lock|example|bak|backup)$">
  Require all denied
</FilesMatch>

# 4. BASIC SECURITY HEADERS
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(self)"
  Header always unset X-Powered-By
</IfModule>

# Backups and development tools are never deployment endpoints.
RedirectMatch 404 (?i)/(scratch|tests|tools|vendor|database|dist|\.test-mysql|\.phpunit\.cache|\.phpstan\.cache)(/|$)
<FilesMatch "(?i)\.(zip|gz|tar|7z|phar|env|ini|bak|backup)$">
  Require all denied
</FilesMatch>

RedirectMatch 404 (?i)/\.test-[^/]*(/|$)

<Files "hash.php">
  Require all denied
</Files>
